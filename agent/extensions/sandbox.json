{
  "enabled": true,
  "network": {
    "allowedDomains": [
      "npmjs.org",
      "*.npmjs.org",
      "*.azureedge.net",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "127.0.0.1:3007",
      "127.0.0.1",
      "localhost",
      "10.0.0.205"
    ],
    "deniedDomains": [],
    "allowLocalBinding": true
  },
  "filesystem": {
    "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg"],
    "allowWrite": [
      ".",
      "~/.pi",
      "~/.volta",
      "~/.npm",
      "~/.cache",
      "~/Library/Caches",
      "/tmp",
      "/private/tmp"
    ],
    "denyWrite": [".env", ".env.*", "*.pem", "*.key"]
  }
}
